# Prusa Connect camera uploader configuration.
# Copy to stack.env (git-ignored) and fill in, then load it in Portainer with
# "Load variables from .env file" in the stack editor.
#
# Format rules (for compatibility between Portainer's parser and Docker Compose):
#   - Do not quote values.
#   - Do not put comments on the same line as a value.
#   - Empty optional values fall back to the script's defaults.

# ---------- Required ----------

# Prusa Connect > Printer > Camera > Add new other camera
PRUSA_CONNECT_TOKEN=

# 16-40 alphanumeric characters. Generate once and never change: openssl rand -hex 16
PRUSA_CONNECT_FINGERPRINT=

# Thingino JPEG endpoint. Include the token here if it authenticates via query string.
CAMERA_SNAPSHOT_URL=

# ---------- Optional: camera auth via header ----------

# Full header line, e.g. Authorization: Bearer abc123 (leave empty if the token is in the URL)
CAMERA_AUTH_HEADER=

# ---------- Optional: upload only while printing ----------

# Printer's local address, e.g. http://192.168.1.50 (leave empty to always upload)
PRUSALINK_URL=
PRUSALINK_USER=maker
# Shown on the printer under its network/PrusaLink settings
PRUSALINK_PASSWORD=
# Only if your firmware uses API-key auth instead of digest; overrides user/password
PRUSALINK_API_KEY=
# Comma-separated printer states during which snapshots are uploaded
UPLOAD_STATES=PRINTING,PAUSED,ATTENTION

# ---------- Tuning ----------

PRUSA_CONNECT_URL=https://connect.prusa3d.com/c/snapshot
UPLOAD_INTERVAL=10
IDLE_INTERVAL=30
MAX_FAILURES=30
HTTP_TIMEOUT=15
# Must exceed IDLE_INTERVAL + HTTP_TIMEOUT, or the container reports unhealthy while idle
HEALTH_MAX_AGE=120
